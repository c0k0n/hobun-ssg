# Security headers for every static response.
# Works with Cloudflare Pages and Workers Static Assets.
# Must stay in sync with src/security.ts, which covers app-generated
# responses (the 404 page). ambient-light-sensor and battery are absent from
# the Permissions-Policy on purpose: Chrome no longer recognizes them, so
# listing them logs "Unrecognized feature" warnings in the console.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()

# No X-Robots-Tag on the wildcard rule: Pages applies it to real 404
# responses too (matched against the requested URL), which would contradict
# the noindex <meta> on the 404 page. Unmatched paths are marked noindex by
# the meta tag alone; the rules below only match direct /404 and /404.html
# requests.

/404
  X-Robots-Tag: noindex, nofollow

/404.html
  X-Robots-Tag: noindex, nofollow
